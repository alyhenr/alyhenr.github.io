{
  "name": "portfolio",
  "stack": "static-html",
  "template": "none",
  "kind": "product",
  "commands": {
    "qa": "node .jarvis/qa.mjs",
    "lint": "node .jarvis/qa.mjs syntax links frozen-urls published",
    "test": "node .jarvis/qa.mjs flows",
    "serve": "node .jarvis/serve.mjs 8000"
  },
  "e2e": "playwright",
  "personal_data": [
    "index.html",
    "js/site.js",
    "js/contact.js",
    "js/contact-config.js",
    "privacidade.html",
    "*privacidade*"
  ],
  "gate": "qa",
  "integrations": [
    {
      "provider": "cloudflare",
      "resource": "turnstile-portfolio-contact",
      "environment": "production",
      "links": {
        "docs": "https://developers.cloudflare.com/turnstile/",
        "dashboard": "https://dash.cloudflare.com/?to=/:account/turnstile"
      },
      "credentials": []
    }
  ]
}
